{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.rogue-spike-3012/bin/rogue-hook claude SessionStart-C1-tilde",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$HOME/.rogue-spike-3012/bin/rogue-hook\" claude SessionStart-C2-home",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"%USERPROFILE%\\.rogue-spike-3012\\bin\\rogue-hook.exe\" claude SessionStart-C3-wincmd",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.rogue-spike-3012/bin/rogue-hook",
            "args": [
              "claude",
              "SessionStart-C4-exec-tilde"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${HOME}/.rogue-spike-3012/bin/rogue-hook",
            "args": [
              "claude",
              "SessionStart-C5-exec-HOME"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:USERPROFILE\\.rogue-spike-3012\\bin\\rogue-hook.exe\" claude SessionStart-C6-pwsh",
            "timeout": 10
          }
        ]
      }
    ],

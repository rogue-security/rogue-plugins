{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.rogue-spike-3012/bin/rogue-hook claude SessionStart-W1-tilde",
            "timeout": 15
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "~/.rogue-spike-3012/bin/rogue-hook claude SessionStart-W2-tilde-pwsh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"%USERPROFILE%\\.rogue-spike-3012\\bin\\rogue-hook.exe\" claude SessionStart-W3-percent",
            "timeout": 15
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:USERPROFILE\\.rogue-spike-3012\\bin\\rogue-hook.exe\" claude SessionStart-W4-envpwsh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "${USERPROFILE}/.rogue-spike-3012/bin/rogue-hook.exe",
            "args": [
              "claude",
              "SessionStart-W5-exec-userprofile"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [

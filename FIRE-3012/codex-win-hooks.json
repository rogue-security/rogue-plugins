            "timeout": 15
          },
          {
            "type": "command",
            "command": "~/.rogue-spike-3012/bin/rogue-hook codex SessionStart-X2-tilde",
            "commandWindows": "& \"$env:USERPROFILE\\.rogue-spike-3012\\bin\\rogue-hook.exe\" codex SessionStart-X2w-pwsh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "~/.rogue-spike-3012/bin/rogue-hook codex SessionStart-X3-tilde-nowin",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "~/.rogue-spike-3012/bin/rogue-hook codex SessionStart-X4-tilde",
